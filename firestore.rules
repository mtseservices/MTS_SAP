rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTenantUser(tenantId) {
      return isSignedIn();
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    // System collections
    match /system/{docId} {
      allow read, write: if isSignedIn();
    }

    // Multi-tenant isolated documents
    match /tenants/{tenantId}/{collectionName}/{docId} {
      allow read, write: if isTenantUser(tenantId);
    }
  }
}
