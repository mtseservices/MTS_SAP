rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default catch-all - STRICT DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // System collections (reachable for network reachability & heartbeat probes)
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Multi-tenant isolated documents & collections
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if isSignedIn(); // Simplified for now, should be tightened per tenant
    }

    // Biometric Credentials
    match /tenants/{tenantId}/users/{userId}/biometricCredentials/{credentialId} {
      allow read, write: if isOwner(userId);
    }

    // Company multi-tenant subcollections
    match /companies/{companyId}/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Tenant API Rate Limits Collection
    match /tenant_rate_limits/{companyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Sessions collection for cross-refresh persistence
    match /sessions/{sessionId} {
      allow read, write: if true; // Basic rule for now, ideally tied to UID if signed in
    }
  }
}
