rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default catch-all for all documents and subcollections
    match /{document=**} {
      allow read, write: if true;
    }

    // System collections
    match /system/{docId} {
      allow read, write: if true;
    }

    // Multi-tenant isolated documents & collections
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if true;
    }

    // Company multi-tenant subcollections (accounts, vouchers, general_ledger, subledgers, inventory, etc.)
    match /companies/{companyId}/{document=**} {
      allow read, write: if true;
    }

    // Tenant API Rate Limits Collection
    match /tenant_rate_limits/{companyId} {
      allow read, write: if true;
    }
  }
}
