{
  "entities": {
    "ClientCompany": {
      "title": "Client Company Tenant",
      "description": "Enterprise tenant company definition",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "slug": { "type": "string" },
        "industry": { "type": "string" },
        "ntn": { "type": "string" },
        "strn": { "type": "string" },
        "status": { "type": "string" },
        "subscriptionPlan": { "type": "string" },
        "subscriptionExpiresAt": { "type": "string" },
        "trialDaysRemaining": { "type": "number" },
        "lastPaymentMethod": { "type": "string" },
        "lastPaymentAmount": { "type": "number" },
        "lastPaymentTxnId": { "type": "string" }
      },
      "required": ["tenantId", "name", "slug"]
    },
    "JournalVoucher": {
      "title": "Journal Voucher",
      "description": "Double-entry financial voucher",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string" },
        "totalAmount": { "type": "number" },
        "narration": { "type": "string" },
        "status": { "type": "string" },
        "tenantId": { "type": "string" }
      },
      "required": ["voucherNo", "totalAmount", "tenantId"]
    },
    "SalesInvoice": {
      "title": "Sales Invoice",
      "description": "Tax invoice document",
      "type": "object",
      "properties": {
        "invoiceNo": { "type": "string" },
        "customerName": { "type": "string" },
        "grandTotal": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "tenantId": { "type": "string" }
      },
      "required": ["invoiceNo", "customerName", "grandTotal", "tenantId"]
    },
    "TenantRateLimit": {
      "title": "Tenant Rate Limit Record",
      "description": "API rate limit tracking and enforcement record per tenant",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "requestCount": { "type": "number" },
        "maxLimit": { "type": "number" },
        "windowStart": { "type": "string" },
        "isRateLimited": { "type": "boolean" }
      },
      "required": ["companyId", "requestCount", "maxLimit", "windowStart"]
    },
    "MasterBankAccount": {
      "title": "Master Software Receiving Bank Account",
      "description": "Central receiving corporate bank accounts configured by Master Admin for subscription payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bankName": { "type": "string" },
        "accountTitle": { "type": "string" },
        "accountNumber": { "type": "string" },
        "iban": { "type": "string" },
        "branchName": { "type": "string" },
        "branchCode": { "type": "string" },
        "swiftCode": { "type": "string" },
        "raastId": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "instructions": { "type": "string" }
      },
      "required": ["id", "bankName", "accountTitle", "accountNumber", "iban", "isActive"]
    },
    "ClientUser": {
      "title": "Client User",
      "description": "User associated with a specific company tenant",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "invitationToken": { "type": "string" }
      },
      "required": ["userId", "tenantId", "name", "email", "role"]
    },
    "BiometricCredential": {
      "title": "Biometric Credential",
      "description": "User's WebAuthn public key credential",
      "type": "object",
      "properties": {
        "credentialId": { "type": "string" },
        "publicKey": { "type": "string" },
        "counter": { "type": "number" },
        "deviceType": { "type": "string" }
      },
      "required": ["credentialId", "publicKey", "counter"]
    },
    "AuthSession": {
      "title": "Authentication Session",
      "description": "Secure record tracking a Master or Tenant user session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isMaster": { "type": "boolean" },
        "tenantId": { "type": "string" },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "branchId": { "type": "string" },
        "branchName": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "LOCKED"] }
      },
      "required": ["sessionId", "userId", "email", "role", "isMaster", "status", "branchId", "branchName"]
    }
  },
  "firestore": {
    "/system/masterBankAccounts": {
      "schema": "MasterBankAccount",
      "description": "Master software corporate receiving accounts for subscription payments"
    },
    "/system/globalSettings": {
      "schema": "ClientCompany",
      "description": "Global Master ERP configurations"
    },
    "/sessions/{sessionId}": {
      "schema": "AuthSession",
      "description": "Cross-refresh persistent user sessions"
    },
    "/tenants/{tenantId}/companies/{companyId}": {
      "schema": "ClientCompany",
      "description": "Tenant company settings"
    },
    "/tenants/{tenantId}/users/{userId}": {
      "schema": "ClientUser",
      "description": "Users within a tenant"
    },
    "/tenants/{tenantId}/users/{userId}/biometricCredentials/{credentialId}": {
      "schema": "BiometricCredential",
      "description": "WebAuthn credentials for a user"
    },
    "/tenants/{tenantId}/vouchers/{voucherId}": {
      "schema": "JournalVoucher",
      "description": "Financial vouchers for a tenant"
    },
    "/tenants/{tenantId}/invoices/{invoiceId}": {
      "schema": "SalesInvoice",
      "description": "Sales invoices for a tenant"
    },
    "/tenant_rate_limits/{companyId}": {
      "schema": "TenantRateLimit",
      "description": "API rate limiting records per tenant company"
    }
  }
}
